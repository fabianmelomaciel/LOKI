{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loki vulnerabilities.json",
  "type": "object",
  "required": ["version", "findings"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "cwe", "iso27001", "file", "finding", "remediation", "poc"],
        "properties": {
          "id": { "type": "string", "pattern": "^LK-[0-9]{3,}$" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "cwe": { "type": "string", "pattern": "^CWE-[0-9]+$" },
          "iso27001": { "type": "string", "pattern": "^A\\.(5|6|7|8)\\.[0-9]{1,2}$", "description": "Control ISO/IEC 27001:2022 Annex A mapeado (ej. A.8.8 gestión de vulnerabilidades técnicas)." },
          "owasp": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "endpoint": { "type": "string" },
          "finding": { "type": "string" },
          "remediation": { "type": "string" },
          "poc": { "type": "string", "maxLength": 1000, "description": "Pasos/string ≤10 líneas, reproducible. Sin secretos vivos ni PII." },
          "snippet": { "type": "string", "maxLength": 800, "description": "≤10 líneas. Nunca dumps de archivos completos." },
          "tier": { "enum": ["t0-pasivo", "t0-activo", "t1", "t2", "t3"] },
          "alcance": { "enum": ["prod", "dev", "ambos"], "description": "Alcance real según contexto dev/prod (.gitignore, devDependencies, pipeline de deploy). prod/ambos priorizados en el informe — ver references/dev-vs-prod.md." },
          "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "enum": ["new", "confirmed", "rejected_fp", "fixed"] }
        }
      }
    }
  }
}

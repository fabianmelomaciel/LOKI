{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "fixture-linter",
          "rules": [
            {
              "id": "FIX001",
              "shortDescription": { "text": "Regla fixture para digest" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "FIX001",
          "level": "warning",
          "message": { "text": "hallazgo fixture" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "README.md" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
